# ============================================================
# GATEWAY_Launcher - Debug Dockerfile
# ============================================================

# --- Stage 1: Build ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/GATEWAY_Launcher/GATEWAY_Launcher.csproj", "GATEWAY_Launcher/"]
COPY ["src/GATEWAY_Core/GATEWAY_Core.csproj", "GATEWAY_Core/"]
RUN dotnet restore "GATEWAY_Launcher/GATEWAY_Launcher.csproj"
COPY src/GATEWAY_Launcher/. ./GATEWAY_Launcher/
COPY src/GATEWAY_Core/. ./GATEWAY_Core/
RUN dotnet publish "GATEWAY_Launcher/GATEWAY_Launcher.csproj" -c Debug -o /app/publish \
    /p:DebugType=portable /p:DebugSymbols=true /p:UseSharedCompilation=false

# --- Stage 2: Runtime ---
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app
EXPOSE 5001 2221

# vsdbg + ssh + user setup (single layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
      unzip procps curl ca-certificates \
      openssh-server openssh-client sudo \
 && update-ca-certificates \
 && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg \
 && mkdir -p /run/sshd \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -G sudo -s /bin/bash robox \
 && echo 'robox:robocross' | chpasswd \
 && echo 'root:robocross'  | chpasswd \
 && echo 'robox ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers \
 && echo 'Defaults:robox !requiretty'    >> /etc/sudoers \
 && mkdir -p /home/robox/.ssh && chmod 700 /home/robox/.ssh \
 && chown -R robox:robox /home/robox/.ssh \
 && sed -i 's/^#\?Port .*/Port 2221/'                                    /etc/ssh/sshd_config \
 && sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/'  /etc/ssh/sshd_config \
 && echo 'PermitRootLogin yes'    >> /etc/ssh/sshd_config \
 && echo 'AllowTcpForwarding yes' >> /etc/ssh/sshd_config \
 && echo 'X11Forwarding no'      >> /etc/ssh/sshd_config

COPY --from=build /app/publish .

RUN chown -R robox:robox /app /vsdbg

ENV ASPNETCORE_URLS=http://+:5001 \
    ASPNETCORE_ENVIRONMENT=Development

# Startup script
RUN printf '#!/bin/bash\n\
set -euo pipefail\n\
mkdir -p /run/sshd\n\
ssh-keygen -A >/dev/null 2>&1 || true\n\
/usr/sbin/sshd -E /var/log/sshd.log -p 2221\n\
echo "sshd started on port 2221"\n\
exec su -s /bin/bash robox -c "cd /app && dotnet GATEWAY_Launcher.dll"\n' > /app/start-debug.sh \
 && chmod +x /app/start-debug.sh

ENTRYPOINT ["/app/start-debug.sh"]