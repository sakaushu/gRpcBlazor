# ============================================================
# GATEWAY_Core - Debug Dockerfile
# ============================================================

# --- Stage 1: Build ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/GATEWAY_Core/GATEWAY_Core.csproj", "GATEWAY_Core/"]
RUN dotnet restore "GATEWAY_Core/GATEWAY_Core.csproj"
COPY src/GATEWAY_Core/. ./GATEWAY_Core/
RUN dotnet build "GATEWAY_Core/GATEWAY_Core.csproj" -c Debug -o /app/build \
    /p:UseSharedCompilation=false

# --- Stage 2: Runtime ---
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app
EXPOSE 5000 2222

# vsdbg + dbus + ssh + user setup (single layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
      unzip procps curl ca-certificates \
      dbus git openssh-server openssh-client sudo \
 && update-ca-certificates \
 && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg \
 && mkdir -p /run/sshd \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -G sudo -s /bin/bash robox \
 && echo 'robox:robocross' | chpasswd \
 && echo 'root:robocross'  | chpasswd \
 && echo 'robox ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers \
 && echo 'Defaults:robox !requiretty'    >> /etc/sudoers \
 && echo 'export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket' \
      >> /home/robox/.bashrc \
 && mkdir -p /home/robox/.ssh && chmod 700 /home/robox/.ssh \
 && chown -R robox:robox /home/robox/.ssh \
 && sed -i 's/^#\?Port .*/Port 2222/'                                    /etc/ssh/sshd_config \
 && sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/'  /etc/ssh/sshd_config \
 && echo 'PermitRootLogin yes'    >> /etc/ssh/sshd_config \
 && echo 'AllowTcpForwarding yes' >> /etc/ssh/sshd_config \
 && echo 'X11Forwarding no'      >> /etc/ssh/sshd_config

COPY --from=build /app/build .

# vsdbg wrapper (sudo via robox SSH session can attach to root process)
RUN chown -R robox:robox /app \
 && chown -R root:root /vsdbg && chmod -R 755 /vsdbg \
 && mv /vsdbg/vsdbg /vsdbg/vsdbg_bin \
 && printf '#!/bin/bash\nexec /usr/bin/sudo -n /vsdbg/vsdbg_bin "$@"\n' > /vsdbg/vsdbg \
 && chmod +x /vsdbg/vsdbg

ENV ASPNETCORE_URLS=http://+:5000 \
    ASPNETCORE_ENVIRONMENT=Development \
    Kestrel__EndpointDefaults__Protocols=Http2 \
    DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket

# Startup script
RUN printf '#!/bin/bash\n\
set -euo pipefail\n\
mkdir -p /run/sshd\n\
ssh-keygen -A >/dev/null 2>&1 || true\n\
/usr/sbin/sshd -E /var/log/sshd.log -p 2222\n\
echo "sshd started on port 2222"\n\
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket\n\
cd /app && exec dotnet GATEWAY_Core.dll\n' > /app/start-debug.sh \
 && chmod +x /app/start-debug.sh

ENTRYPOINT ["/app/start-debug.sh"]