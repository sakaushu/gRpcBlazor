FROM mcr.microsoft.com/dotnet/sdk:10.0 AS base
WORKDIR /app
EXPOSE 5001

# Install vsdbg for remote debugging
RUN apt-get update && apt-get install -y unzip procps && \
    curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg && \
    rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/GATEWAY_Core/GATEWAY_Core.csproj", "GATEWAY_Core/"]
RUN dotnet restore "GATEWAY_Core/GATEWAY_Core.csproj"

COPY src/GATEWAY_Core/. ./GATEWAY_Core/
RUN dotnet build "GATEWAY_Core/GATEWAY_Core.csproj" -c Debug -o /app/build

FROM build AS publish
RUN dotnet publish "GATEWAY_Core/GATEWAY_Core.csproj" -c Debug -o /app/publish

FROM base AS final
# Install dbus for system operations
RUN apt-get update && apt-get install -y dbus && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "GATEWAY_Core.dll"]