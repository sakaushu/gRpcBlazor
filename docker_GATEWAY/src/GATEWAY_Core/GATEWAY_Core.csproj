<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\proxy_config.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\network_config.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\time_config.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\config.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\aziotedge_config.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\portforward_config.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.4" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Tmds.DBus" Version="0.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings*.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

	<ItemGroup>
		<!-- Configs フォルダをビルド出力にコピー -->
		<Content Include="Configs/**/*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
