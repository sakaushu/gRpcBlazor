FROM mcr.microsoft.com/dotnet/sdk:10.0 AS base
WORKDIR /app
EXPOSE 5000

# vsdbg と必要ツールを導入（curl/ca-certificates を追加）
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip procps curl ca-certificates \
 && update-ca-certificates \
 && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg \
 && rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/GATEWAY_Core/GATEWAY_Core.csproj", "GATEWAY_Core/"]
RUN dotnet restore "GATEWAY_Core/GATEWAY_Core.csproj"

COPY src/GATEWAY_Core/. ./GATEWAY_Core/
# SharedCompilation 無効化で安定度を向上
RUN dotnet build "GATEWAY_Core/GATEWAY_Core.csproj" -c Debug -o /app/build /p:UseSharedCompilation=false

FROM build AS publish
# DebugType=portable で PDB を同梱（embedded から変更）
RUN dotnet publish "GATEWAY_Core/GATEWAY_Core.csproj" -c Debug -o /app/publish \
    /p:DebugType=portable /p:DebugSymbols=true /p:UseSharedCompilation=false

FROM base AS final
# dbus / git / ssh を導入（sshd 設定は“追記”で確実化）
RUN apt-get update && apt-get install -y --no-install-recommends \
    dbus git openssh-server openssh-client sudo \
 && mkdir -p /run/sshd \
 && rm -rf /var/lib/apt/lists/*

# 開発用ユーザー作成（パスワードは必要に応じて修正）
RUN useradd -m -s /bin/bash robox \
 && echo 'robox:robocross' | chpasswd \
 && echo 'robox ALL=(ALL) NOPASSWD: /app/start-debug.sh' >> /etc/sudoers \
 && echo 'robox ALL=(ALL) NOPASSWD: /usr/bin/dotnet' >> /etc/sudoers \
 && echo 'robox ALL=(ALL) NOPASSWD: /vsdbg/vsdbg' >> /etc/sudoers \
 && echo 'export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket' >> /home/robox/.bashrc

WORKDIR /app
COPY --from=build /app/build .
COPY --from=base /vsdbg /vsdbg
EXPOSE 2222

# ASP.NET Core / D-Bus
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Development
ENV Kestrel__EndpointDefaults__Protocols=Http2
ENV DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket

RUN chown -R robox:robox /app

# sshd 設定（開発用途）
RUN set -eux; \
    grep -q '^Port ' /etc/ssh/sshd_config && sed -i 's/^Port .*/Port 2222/' /etc/ssh/sshd_config || echo 'Port 2222' >> /etc/ssh/sshd_config; \
    grep -q '^PasswordAuthentication ' /etc/ssh/sshd_config && sed -i 's/^PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config || echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config; \
    echo 'PermitRootLogin no' >> /etc/ssh/sshd_config

# 起動スクリプト
RUN printf '#!/bin/bash\n' > /app/start-debug.sh \
 && printf 'set -euo pipefail\n' >> /app/start-debug.sh \
 && printf 'mkdir -p /run/sshd\n' >> /app/start-debug.sh \
 && printf 'ssh-keygen -A >/dev/null 2>&1 || true\n' >> /app/start-debug.sh \
 && printf '/usr/sbin/sshd -E /var/log/sshd.log -p 2222\n' >> /app/start-debug.sh \
 && printf 'echo "sshd started on port 2222"\n' >> /app/start-debug.sh \
 && printf 'export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket\n' >> /app/start-debug.sh \
 && printf 'cd /app && exec dotnet GATEWAY_Core.dll\n' >> /app/start-debug.sh \
 && chmod +x /app/start-debug.sh

ENTRYPOINT ["/app/start-debug.sh"]